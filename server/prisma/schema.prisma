generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MovementType {
  ENTRADA
  SALIDA
  AJUSTE
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

model Role {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(50)
  descripcion String     @default("") @db.VarChar(150)
  employees   Employee[]

  @@map("roles")
}

model Employee {
  id           Int            @id @default(autoincrement())
  rolId        Int            @map("rol_id")
  nombre       String         @db.VarChar(80)
  apellido     String         @db.VarChar(80)
  cedula       String?        @unique @db.VarChar(20)
  telefono     String?        @db.VarChar(30)
  username     String         @unique @db.VarChar(50)
  passwordHash String         @map("password_hash") @db.VarChar(100)
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime       @default(now()) @map("updated_at") @db.Timestamptz()

  role           Role            @relation(fields: [rolId], references: [id])
  stockMovements StockMovement[]
  sales          Sale[]

  @@map("employees")
}

model Category {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(80)
  descripcion String    @default("") @db.VarChar(150)
  products    Product[]

  @@map("categories")
}

model Product {
  id           Int            @id @default(autoincrement())
  categoriaId  Int?           @map("categoria_id")
  codigoBarras String?        @unique @map("codigo_barras") @db.VarChar(48)
  nombre       String         @db.VarChar(120)
  descripcion  String?        @db.Text()
  precioCosto  Decimal        @map("precio_costo") @db.Decimal(12, 2)
  precioVenta  Decimal        @map("precio_venta") @db.Decimal(12, 2)
  stockMinimo  Int            @default(0) @map("stock_minimo")
  stockActual  Int            @default(0) @map("stock_actual")
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime       @default(now()) @map("updated_at") @db.Timestamptz()

  category       Category?       @relation(fields: [categoriaId], references: [id])
  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@index([codigoBarras], map: "idx_products_barcode")
  @@index([nombre], map: "idx_products_nombre")
  @@map("products")
}

model StockMovement {
  id        Int          @id @default(autoincrement())
  productId Int          @map("product_id")
  tipo      MovementType
  cantidad  Int
  motivo    String       @default("") @db.VarChar(255)
  userId    Int?         @map("user_id")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  product Product  @relation(fields: [productId], references: [id])
  user    Employee? @relation(fields: [userId], references: [id])

  @@index([productId, createdAt], map: "idx_movements_product")
  @@map("stock_movements")
}

model Sale {
  id            Int           @id @default(autoincrement())
  userId        Int           @map("user_id")
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  descuento     Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  metodoPago    PaymentMethod @default(EFECTIVO) @map("metodo_pago")
  montoRecibido Decimal       @default(0) @map("monto_recibido") @db.Decimal(12, 2)
  cambio        Decimal       @default(0) @db.Decimal(12, 2)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  user      Employee  @relation(fields: [userId], references: [id])
  saleItems SaleItem[]
  receipt   Receipt?

  @@map("sales")
}

model SaleItem {
  id              Int     @id @default(autoincrement())
  saleId          Int     @map("sale_id")
  productId       Int     @map("product_id")
  cantidad        Int
  precioVentaUnit Decimal @map("precio_venta_unit") @db.Decimal(12, 2)
  subtotal        Decimal @db.Decimal(12, 2)
  margenUnitario  Decimal @map("margen_unitario") @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId], map: "idx_sale_items_sale")
  @@index([productId], map: "idx_sale_items_product")
  @@map("sale_items")
}

model Receipt {
  id        Int      @id @default(autoincrement())
  saleId    Int      @unique @map("sale_id")
  numero    String   @unique @db.VarChar(24)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  sale Sale @relation(fields: [saleId], references: [id])

  @@map("receipts")
}

model StoreSettings {
  id        Int       @id @default(autoincrement())
  nombre    String    @default("La Bendición") @db.VarChar(120)
  direccion String    @default("") @db.VarChar(255)
  telefono  String    @default("") @db.VarChar(30)
  logoUrl   String?   @map("logo_url")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  @@map("store_settings")
}
