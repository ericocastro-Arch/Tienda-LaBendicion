# Copia este archivo como .env en la raíz del repositorio.
# Esta configuración funciona con: docker compose up -d
PORT=4000
NODE_ENV=development
API_PUBLIC_URL=http://localhost:4000

# PostgreSQL expuesto por compose.yaml
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/labendicion_db
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=labendicion_db

# Usa una clave larga y aleatoria fuera del entorno de desarrollo.
JWT_SECRET=cambia-esta-clave-en-produccion
JWT_TTL=8h
BCRYPT_SALT_ROUNDS=12
